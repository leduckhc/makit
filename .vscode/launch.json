{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Makit Desktop (Debug, Isolated Profile)",
      "type": "dart",
      "request": "launch",
      "program": "app/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "args": [
        "-d",
        "macos"
      ],
      "deviceId": "macos",
      "flutterMode": "debug",
      "preLaunchTask": "makit: start isolated daemon",
      "env": {
        "MAKIT_WS_URL": "",
        "MAKIT_FP": ""
      },
      "postDebugTask": "makit: cleanup",
      "console": "integratedTerminal"
    },
    {
      "name": "Makit Desktop (Release)",
      "type": "dart",
      "request": "launch",
      "program": "app/lib/main.dart",
      "cwd": "${workspaceFolder}",
      "args": [
        "-d",
        "macos",
        "--release"
      ],
      "deviceId": "macos",
      "flutterMode": "release",
      "console": "integratedTerminal"
    }
  ]
}
