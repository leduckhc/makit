{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "makit: debug server",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/debug-desktop.sh",
      "args": ["--server-only", "${workspaceFolder}"],
      "options": { "env": { "MAKIT_DEBUG_PORT": "7990" } },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "==> starting server",
          "endsPattern": "wss listening"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": false }
    }
  ]
}
