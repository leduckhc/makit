{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "makit: start isolated daemon",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/debug-desktop.sh",
        "--no-app"
      ],
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*✓ daemon started.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*==> Starting daemon.*$",
          "endsPattern": "^.*✓ daemon.*$"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "makit: cleanup",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/debug-desktop.sh",
        "--kill"
      ],
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
