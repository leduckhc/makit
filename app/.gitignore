# ---------------------------------------------------------------------------
# Platform folders are COMMITTED (they hold hand-written native code:
# QrScannerPlugin.swift, AppDelegate/SceneDelegate, Info.plist permissions,
# entitlements, splash + icon assets). Only ignore the machine-specific and
# build-generated files inside them — per Flutter's standard .gitignore.
# ---------------------------------------------------------------------------

