{
  "name": "@pino/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "bin": {
    "pino": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.startsWith('pnpm')){console.error('\\n[pino] Use pnpm: corepack enable && pnpm install\\n');process.exit(1)}\"",
    "dev": "tsx watch src/index.ts serve",
    "start": "tsx src/index.ts serve",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "secure:install": "pnpm install --frozen-lockfile",
    "secure:audit": "pnpm audit --prod"
  },
  "dependencies": {
    "bonjour-service": "^1.4.2",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  }
}
