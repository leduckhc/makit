{
  "name": "@pino/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "bin": {
    "pino": "./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.startsWith('pnpm')){console.error('\\n[pino] Use pnpm: corepack enable && pnpm install\\n');process.exit(1)}\"",
    "dev": "tsx watch src/index.ts serve",
    "start": "tsx src/index.ts serve",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "secure:install": "pnpm install --frozen-lockfile",
    "secure:audit": "pnpm audit --prod"
  },
  "dependencies": {
    "bonjour-service": "^1.2.1",
    "qrcode-terminal": "^0.12.0",
    "selfsigned": "^2.4.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
