# Auth + a few CLI hardening defaults. The bulk of pnpm policy lives in
# `pnpm-workspace.yaml` (single source of truth — see SECURITY.md).

# Refuse the install if Node/pnpm `engines` don't match `package.json`.
engine-strict=true

# Defense in depth: don't run dependency lifecycle scripts on bare npm/npx
# either (in case someone runs `npm i` against this repo by mistake).
# pnpm has its own stricter mechanism (`strictDepBuilds` + `allowBuilds`).
ignore-scripts=true
